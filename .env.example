# ── Hastane Nöbet — Frontend Ortam Değişkenleri ─────────────────────────
# Bu dosyayı .env veya .env.local olarak kopyalayın ve değerleri doldurun.
# Gerçek değerleri bu dosyaya YAZMAYIN — sadece örnek/placeholder kullanın.
# Vercel / CI ortamında bu değerleri "Environment Variables" panelinden ekleyin.

# ── Backend API ──────────────────────────────────────────────────────────
# Production: Railway backend URL
# Development: Vite proxy aktiftir, bu değer boş bırakılabilir
VITE_API_BASE=https://your-backend.up.railway.app

# ── Ortam Modu ───────────────────────────────────────────────────────────
# prod | staging | development
VITE_API_ENV=prod

# ── Online Mod ───────────────────────────────────────────────────────────
# Production'da her zaman true
VITE_ONLINE_ONLY=true

# ── Production Yazma İzinleri ─────────────────────────────────────────────
# Hangi roller production'da veri yazabilir (virgülle ayrılmış)
VITE_PROD_WRITE_ROLES=ADMIN

# ── Backend Zorunluluğu ──────────────────────────────────────────────────
# Production'da her zaman true
VITE_REQUIRE_BACKEND=true
