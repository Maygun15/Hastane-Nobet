# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/hastane
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hastane

# ── Redis (opsiyonel — rate limit / cache) ────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=degistir-uzun-ve-rastgele-bir-deger
JWT_REFRESH_SECRET=degistir-ayri-uzun-ve-rastgele-bir-deger
# Üret: openssl rand -hex 32

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
# Production: https://yourdomain.vercel.app

# ── Admin bootstrap (ilk kurulumda otomatik admin oluşturur) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=guclu-sifre-gir
RESET_ADMIN_PASSWORD=false

# ── SMTP (şifre sıfırlama maili) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
NOTIFICATIONS_ENABLED=false

# ── Harici API'ler ────────────────────────────────────────────
CALENDARIFIC_API_KEY=

# ── AI / LLM (gelecek özellikler için) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic    # openai | anthropic
# AI_MODEL=claude-3-5-haiku-20241022

# ── Hata izleme ───────────────────────────────────────────────
SENTRY_DSN=

# ── Dev (production'da false yapın) ──────────────────────────
ALLOW_DEV_ENDPOINTS=false
